#!/bin/sh
set -e

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "./scripts/check-doc-sync.ps1"
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "./scripts/check-doc-sync.ps1"
else
  echo "Doc sync check skipped: pwsh/powershell is not available."
  exit 0
fi
