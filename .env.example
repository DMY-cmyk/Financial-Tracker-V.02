# Financial Tracker — Environment Variables
# Copy this file to .env.local and fill in values as needed.

# ── Database ─────────────────────────────────────────────────
# Neon Postgres connection string (required for production / Vercel).
# When not set, falls back to in-memory SQLite for local dev.
# Get a free database at https://neon.tech
DATABASE_URL=

# ── App Config ──────────────────────────────────────────────
# Base URL for deployment (leave empty for root)
NEXT_PUBLIC_BASE_PATH=

# App title override (optional)
NEXT_PUBLIC_APP_TITLE=Financial Tracker

# ── Analytics (future) ─────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Feature Flags (future) ─────────────────────────────────
# NEXT_PUBLIC_ENABLE_OCR=true
# NEXT_PUBLIC_ENABLE_IMPORT=true
