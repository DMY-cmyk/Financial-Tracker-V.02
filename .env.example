# Financial Tracker — Environment Variables
# Copy this file to .env.local and fill in values as needed.

# ── Database ─────────────────────────────────────────────────
# Neon Postgres connection string (required for production / Vercel).
# When not set, falls back to in-memory SQLite for local dev.
# Get a free database at https://neon.tech
DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────
# Secret for signing session JWTs. REQUIRED in production — the app
# refuses to issue or verify sessions without it. Generate with:
#   openssl rand -base64 32
JWT_SECRET=

# ── Cron ─────────────────────────────────────────────────────
# Bearer token protecting POST /api/cron/generate-recurring.
# Required in production; Vercel Cron also authenticates via
# x-vercel-cron-signature.
CRON_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Financial Tracker <noreply@example.com>

# --- App ---
APP_URL=http://localhost:3000

# --- Google OAuth ---
# Redirect URI is derived from APP_URL as
# ${APP_URL}/api/auth/google/callback — register that in Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
